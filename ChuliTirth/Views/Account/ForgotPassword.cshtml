@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<section class="ct-section">
    <div class="container-ct" style="max-width:420px;">
        <div class="ct-section-title" style="text-align:left;">
            <h2>Forgot Password</h2>
            <p class="ct-muted">Enter your account email and we'll send you a link to reset your password.</p>
        </div>
        <div asp-validation-summary="All" class="ct-alert ct-alert-danger"></div>
        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="ct-card" style="padding:1.5rem;">
            @Html.AntiForgeryToken()
            <div class="mb-3 ct-field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger"></span></div>
            <button type="submit" class="btn-ct-primary w-100 justify-content-center">Send Reset Link</button>
            <p class="mt-3 text-center ct-muted"><a asp-controller="Account" asp-action="Login">Back to login</a></p>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

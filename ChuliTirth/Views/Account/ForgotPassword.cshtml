@using System.Globalization
@using ChuliTirth.Helpers
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    string T(string key) => UiText.T(CultureInfo.CurrentUICulture, key);
}
<section class="ct-section">
    <div class="container-ct" style="max-width:420px;">
        <div class="ct-section-title" style="text-align:left;">
            <h2>@T("ForgotPasswordHeading")</h2>
            <p class="ct-muted">@T("ForgotPasswordDesc")</p>
        </div>
        <div asp-validation-summary="All" class="ct-alert ct-alert-danger"></div>
        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="ct-card" style="padding:1.5rem;">
            @Html.AntiForgeryToken()
            <div class="mb-3 ct-field"><label asp-for="Email">@T("EmailLabel")</label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger"></span></div>
            <button type="submit" class="btn-ct-primary w-100 justify-content-center">@T("SendResetLink")</button>
            <p class="mt-3 text-center ct-muted"><a asp-controller="Account" asp-action="Login">@T("BackToLogin")</a></p>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

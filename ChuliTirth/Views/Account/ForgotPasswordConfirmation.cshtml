@{
    ViewData["Title"] = "Check Your Email";
}
<section class="ct-section">
    <div class="container-ct" style="max-width:420px;">
        <div class="ct-alert ct-alert-success">
            <i class="bi bi-envelope-check"></i>
            If an account exists with that email, a password reset link has been sent. It will expire in 1 hour.
        </div>
        <p class="text-center"><a asp-controller="Account" asp-action="Login" class="btn-ct-secondary">Back to login</a></p>
    </div>
</section>

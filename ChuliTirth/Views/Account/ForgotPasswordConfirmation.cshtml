@using System.Globalization
@using ChuliTirth.Helpers
@{
    ViewData["Title"] = "Check Your Email";
    string T(string key) => UiText.T(CultureInfo.CurrentUICulture, key);
}
<section class="ct-section">
    <div class="container-ct" style="max-width:420px;">
        <div class="ct-alert ct-alert-success">
            <i class="bi bi-envelope-check"></i>
            @T("ResetLinkSentMsg")
        </div>
        <p class="text-center"><a asp-controller="Account" asp-action="Login" class="btn-ct-secondary">@T("BackToLogin")</a></p>
    </div>
</section>

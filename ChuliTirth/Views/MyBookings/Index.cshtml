@using System.Globalization
@using ChuliTirth.Helpers
@model List<Booking>
@{
    ViewData["Title"] = "My Bookings";
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(5.5));
    var cultureInfo = CultureInfo.CurrentUICulture;
    string T(string key) => UiText.T(cultureInfo, key);
}
<section class="ct-section">
    <div class="container-ct">
        <div class="ct-section-title" style="text-align:left;"><h2>@T("MyBookings")</h2></div>

        @if (!Model.Any())
        {
            <div class="ct-alert ct-alert-info">@T("NoBookingsYet") <a asp-controller="Rooms" asp-action="Index">@T("BrowseRooms")</a> @T("ToGetStarted")</div>
        }
        else
        {
            <div class="table-responsive-ct">
                <table class="table-ct w-100">
                    <thead>
                        <tr><th>@T("BookingNumber")</th><th>@T("Room")</th><th>@T("Dates")</th><th>@T("GuestsShort")</th><th>@T("AmountLabel")</th><th>@T("Payment")</th><th>@T("Status")</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>@b.BookingNumber</td>
                                <td>@string.Join(", ", b.BookingRooms.Select(r => LocalizationHelper.Pick(cultureInfo, r.RoomType.Name, r.RoomType.NameGujarati, r.RoomType.NameHindi)).Distinct())</td>
                                <td>@b.CheckIn.ToString("dd MMM") &rarr; @b.CheckOut.ToString("dd MMM yyyy")</td>
                                <td>@(b.Adults + b.Children)</td>
                                <td>₹@b.TotalAmount.ToString("N0")</td>
                                <td>@b.PaymentStatus</td>
                                <td><span class="ct-badge ct-badge-@(b.Status.ToString().ToLower())">@b.Status</span></td>
                                <td>
                                    @if (b.Status is BookingStatus.Pending or BookingStatus.PaymentPending or BookingStatus.Confirmed && b.CheckIn > today)
                                    {
                                        var preview = ((Dictionary<int, string>)ViewBag.CancellationPreviews)[b.Id];
                                        <form asp-controller="MyBookings" asp-action="Cancel" method="post" onsubmit="return confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize("Cancel this booking?\n\n" + preview)));">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="reason" value="Cancelled by guest" />
                                            <button type="submit" class="btn-ct-secondary" style="padding:0.3rem 0.8rem;font-size:0.8rem;">@T("Cancel")</button>
                                        </form>
                                        <div class="ct-muted" style="font-size:0.72rem;max-width:220px;">@preview</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

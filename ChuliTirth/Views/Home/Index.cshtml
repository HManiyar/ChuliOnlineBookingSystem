@using System.Globalization
@using ChuliTirth.Helpers
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    string S(string key, string fallback) => Model.Settings.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v! : fallback;
    var cultureInfo = CultureInfo.CurrentUICulture;
    string T(string key) => UiText.T(cultureInfo, key);
}
@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LodgingBusiness",
        "name": "@S("DharamshalaName", "Chuli Tirth Dharamshala")",
        "address": "@S("Address", "Chuli Tirth, Gujarat, India")",
        "telephone": "@S("Phone", "+91 99999 00000")",
        "email": "@S("Email", "info@chulitirth.local")"
    }
    </script>
}

<section class="ct-hero">
    <div class="container-ct">
        <h1>@S("HomepageHeroText", "Experience Peace and Devotion at Chuli Tirth")</h1>
        <p class="lead">@T("HomeHeroLead")</p>
        <div class="ct-hero-actions">
            <a asp-controller="Rooms" asp-action="Index" class="btn-ct-gold">@T("BookYourStay")</a>
            <a asp-controller="Rooms" asp-action="Index" class="btn-ct-secondary" style="border-color:#fff;color:#fff;">@T("ViewRooms")</a>
        </div>
    </div>
</section>

<div class="container-ct">
    <div class="ct-search-card">
        <form asp-controller="Booking" asp-action="Availability" method="get" data-booking-search>
            <div class="ct-search-grid">
                <div class="ct-field">
                    <label for="checkIn">@T("CheckIn")</label>
                    <input type="date" class="form-control ct-checkin-input" id="checkIn" name="checkIn" data-max-nights="@AppSettings.Value.MaxBookingNights" value="@Model.Search.CheckIn?.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="ct-field">
                    <label for="checkOut">@T("CheckOut")</label>
                    <input type="date" class="form-control ct-checkout-input" id="checkOut" name="checkOut" value="@Model.Search.CheckOut?.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="ct-field">
                    <label for="guests">@T("Guests")</label>
                    <input type="number" min="1" max="30" class="form-control" id="guests" name="guests" value="@Model.Search.Guests" />
                </div>
                <div class="ct-field">
                    <label for="rooms">@T("RoomsCount")</label>
                    <input type="number" min="1" max="10" class="form-control" id="rooms" name="rooms" value="@Model.Search.Rooms" />
                </div>
                <div class="ct-field">
                    <button type="submit" class="btn-ct-primary" style="width:100%;justify-content:center;"><i class="bi bi-search"></i> @T("CheckAvailability")</button>
                </div>
            </div>
        </form>
    </div>
</div>

<section class="ct-section">
    <div class="container-ct">
        <div class="ct-section-title">
            <div class="eyebrow">@T("AboutTheTirth")</div>
            <h2>@T("SacredPlaceHeading")</h2>
            <p class="ct-muted">@T("HomeAboutSample")</p>
        </div>
    </div>
</section>

<section class="ct-section ct-section-alt">
    <div class="container-ct">
        <div class="ct-section-title">
            <div class="eyebrow">@T("AccommodationEyebrow")</div>
            <h2>@T("RoomCategories")</h2>
        </div>
        <div class="ct-grid">
            @foreach (var rt in Model.RoomTypes)
            {
                <partial name="_RoomCard" model="rt" />
            }
        </div>
    </div>
</section>

<section class="ct-section">
    <div class="container-ct">
        <div class="ct-section-title">
            <div class="eyebrow">@T("Amenities")</div>
            <h2>@T("Facilities")</h2>
        </div>
        <div class="ct-grid" style="grid-template-columns: repeat(auto-fill, minmax(140px,1fr));">
            @foreach (var f in Model.Facilities)
            {
                <div class="ct-card ct-facility">
                    <i class="bi @(string.IsNullOrWhiteSpace(f.Icon) ? "bi-check-circle" : f.Icon)"></i>
                    <div class="label">@LocalizationHelper.Pick(cultureInfo, f.Name, f.NameGujarati, f.NameHindi)</div>
                </div>
            }
        </div>
    </div>
</section>

<section class="ct-section ct-section-alt">
    <div class="container-ct">
        <div class="ct-section-title">
            <div class="eyebrow">@T("WhyStayWithUs")</div>
            <h2>@T("JainValuesHeading")</h2>
        </div>
        <div class="ct-grid">
            <div class="ct-card" style="padding:1.25rem;"><i class="bi bi-shield-check" style="color:var(--ct-gold);font-size:1.5rem;"></i><h5 class="mt-2">@T("SafePeaceful")</h5><p class="ct-muted">@T("SafePeacefulDesc")</p></div>
            <div class="ct-card" style="padding:1.25rem;"><i class="bi bi-egg-fried" style="color:var(--ct-gold);font-size:1.5rem;"></i><h5 class="mt-2">@T("PureJainBhojan")</h5><p class="ct-muted">@T("PureJainBhojanDesc")</p></div>
            <div class="ct-card" style="padding:1.25rem;"><i class="bi bi-people" style="color:var(--ct-gold);font-size:1.5rem;"></i><h5 class="mt-2">@T("FamilyFriendly")</h5><p class="ct-muted">@T("FamilyFriendlyDesc")</p></div>
            <div class="ct-card" style="padding:1.25rem;"><i class="bi bi-flower1" style="color:var(--ct-gold);font-size:1.5rem;"></i><h5 class="mt-2">@T("SpiritualAtmosphere")</h5><p class="ct-muted">@T("SpiritualAtmosphereDesc")</p></div>
        </div>
    </div>
</section>

@if (Model.GalleryPreview.Any())
{
    <section class="ct-section">
        <div class="container-ct">
            <div class="ct-section-title">
                <div class="eyebrow">@T("Glimpses")</div>
                <h2>@T("Gallery")</h2>
            </div>
            <div class="ct-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px,1fr));">
                @foreach (var img in Model.GalleryPreview)
                {
                    var catName = LocalizationHelper.Pick(cultureInfo, img.GalleryCategory.Name, img.GalleryCategory.NameGujarati, img.GalleryCategory.NameHindi);
                    <a href="@img.ImageUrl" class="ct-gallery-img-link">
                        <img src="@img.ImageUrl" alt="@catName" loading="lazy" style="width:100%;height:150px;object-fit:cover;" />
                    </a>
                }
            </div>
            <div class="text-center mt-3">
                <a asp-controller="Gallery" asp-action="Index" class="btn-ct-secondary">@T("ViewFullGallery")</a>
            </div>
        </div>
    </section>
}

<section class="ct-section ct-section-alt">
    <div class="container-ct" style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
        <div>
            <div class="ct-section-title" style="text-align:left;">
                <div class="eyebrow">@T("GetInTouch")</div>
                <h2>@T("ContactAndLocation")</h2>
            </div>
            <p><i class="bi bi-geo-alt"></i> @S("Address", "Chuli Tirth, Gujarat, India")</p>
            <p><i class="bi bi-telephone"></i> @S("Phone", "+91 99999 00000")</p>
            <p><i class="bi bi-envelope"></i> @S("Email", "info@chulitirth.local")</p>
            <a asp-controller="Contact" asp-action="Index" class="btn-ct-primary">@T("ContactUs")</a>
        </div>
        <div>
            <iframe title="Location map" src="https://maps.google.com/maps?q=Chuli%20Jain%20Tirth&t=&z=13&ie=UTF8&iwloc=&output=embed" style="width:100%;height:260px;border:0;border-radius:10px;" loading="lazy"></iframe>
        </div>
    </div>
</section>

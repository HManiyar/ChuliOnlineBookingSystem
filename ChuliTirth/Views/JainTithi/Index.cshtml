@using System.Globalization
@using ChuliTirth.Helpers
@model List<JainTithi>
@{
    ViewData["Title"] = "Jain Tithi Calendar";
    var culture = CultureInfo.CurrentUICulture;
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(5.5));
    string T(string key) => UiText.T(culture, key);
}
<section class="ct-section">
    <div class="container-ct" style="max-width:800px;">
        <div class="ct-section-title"><h2>@T("JainTithiCalendar")</h2><p class="ct-muted">Sample calendar data for demonstration — connect a verified Jain calendar source via IJainCalendarService for production use.</p></div>
        <div class="table-responsive-ct">
            <table class="table-ct w-100">
                <thead><tr><th>@T("Date")</th><th>@T("Paksha")</th><th>@T("Tithi")</th><th>@T("SpecialOccasion")</th></tr></thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var paksha = LocalizationHelper.Pick(culture, t.Paksha ?? "", t.PakshaGujarati, t.PakshaHindi);
                        var tithi = LocalizationHelper.Pick(culture, t.TithiName, t.TithiNameGujarati, t.TithiNameHindi);
                        var occasion = LocalizationHelper.Pick(culture, t.SpecialOccasion ?? "", t.SpecialOccasionGujarati, t.SpecialOccasionHindi);
                        <tr class="@(t.GregorianDate == today ? "fw-bold" : "")">
                            <td>@t.GregorianDate.ToString("dd MMM yyyy") @(t.GregorianDate == today ? $"({T("Today")})" : "")</td>
                            <td>@paksha</td>
                            <td>@tithi</td>
                            <td class="ct-muted">@occasion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

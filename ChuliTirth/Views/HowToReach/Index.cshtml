@using System.Globalization
@using ChuliTirth.Helpers
@model Dictionary<string, string?>
@{
    ViewData["Title"] = "How to Reach";
    string S(string key, string fallback) => Model.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v! : fallback;
    string T(string key) => UiText.T(CultureInfo.CurrentUICulture, key);
}
<section class="ct-section">
    <div class="container-ct" style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
        <div>
            <div class="ct-section-title" style="text-align:left;"><h2>@T("HowToReach")</h2></div>
            <p><i class="bi bi-geo-alt"></i> @S("Address", "Chuli Tirth, Gujarat, India")</p>
            <h5 class="mt-3">By Rail</h5>
            <p class="ct-muted">Sample content — nearest railway station details to be updated by admin.</p>
            <h5 class="mt-3">By Air</h5>
            <p class="ct-muted">Sample content — nearest airport details to be updated by admin.</p>
            <h5 class="mt-3">By Road</h5>
            <p class="ct-muted">Sample content — bus station and driving directions to be updated by admin.</p>
            <h5 class="mt-3">Parking</h5>
            <p class="ct-muted">On-site parking available for cars and buses.</p>
        </div>
        <div>
            <iframe title="Location map" src="https://maps.google.com/maps?q=Chuli%20Jain%20Tirth&t=&z=13&ie=UTF8&iwloc=&output=embed" style="width:100%;height:320px;border:0;border-radius:10px;" loading="lazy"></iframe>
        </div>
    </div>
</section>

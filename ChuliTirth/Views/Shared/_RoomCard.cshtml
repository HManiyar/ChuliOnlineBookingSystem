@model RoomType
@{
    var image = Model.Images?.OrderBy(i => i.DisplayOrder).FirstOrDefault();
    var imgUrl = image?.ImageUrl ?? "/images/rooms/placeholder-room.svg";
}
<div class="ct-card ct-room-card">
    <img src="@imgUrl" alt="@(image?.AltText ?? Model.Name)" loading="lazy" />
    <div class="body">
        <h5 class="mb-0">@Model.Name</h5>
        <div class="ct-muted" style="font-size:0.85rem;">
            <i class="bi bi-people"></i> Up to @Model.Capacity guests &nbsp;·&nbsp;
            <i class="bi bi-door-closed"></i> @Model.BedCount beds
        </div>
        <p class="ct-muted" style="font-size:0.9rem;flex:1;">@Model.Description</p>
        <div class="amenities">
            @if (Model.IsAC) { <span class="ct-amenity-pill">AC</span> }
            @if (Model.HasAttachedBathroom) { <span class="ct-amenity-pill">Attached Bathroom</span> }
            @if (Model.HasHotWater) { <span class="ct-amenity-pill">Hot Water</span> }
            @if (Model.HasWifi) { <span class="ct-amenity-pill">Wi-Fi</span> }
            @if (Model.HasParking) { <span class="ct-amenity-pill">Parking</span> }
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="price">₹@Model.Price.ToString("N0") <small class="ct-muted">/ night</small></span>
            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Id" class="btn-ct-secondary">View Details</a>
        </div>
    </div>
</div>

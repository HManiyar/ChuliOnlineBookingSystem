@using System.Globalization
@using ChuliTirth.Helpers
@model Dictionary<string, string?>
@{
    ViewData["Title"] = "About Us";
    string S(string key, string fallback) => Model.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v! : fallback;
    string T(string key) => UiText.T(CultureInfo.CurrentUICulture, key);
}
<section class="ct-section">
    <div class="container-ct" style="max-width:800px;">
        <div class="ct-section-title" style="text-align:left;"><h2>@T("About") @S("DharamshalaName", "Chuli Tirth Dharamshala")</h2></div>

        <h5>@T("AboutTheTirth")</h5>
        <p class="ct-muted">@T("AboutTirthSample")</p>

        <h5 class="mt-4">@T("DharamshalaManagement")</h5>
        <p class="ct-muted">@T("DharamshalaManagementSample")</p>

        <h5 class="mt-4">@T("OurMission")</h5>
        <p class="ct-muted">@T("OurMissionSample")</p>

        <h5 class="mt-4">@T("VisitorInformation")</h5>
        <p class="ct-muted">@T("CheckIn"): @S("CheckInTime", "12:00") &nbsp;·&nbsp; @T("CheckOut"): @S("CheckOutTime", "10:00"). @T("PleaseReviewRulesPrefix") <a asp-controller="BookingRules" asp-action="Index">@T("BookingRules")</a> @T("PleaseReviewRulesSuffix")</p>
    </div>
</section>

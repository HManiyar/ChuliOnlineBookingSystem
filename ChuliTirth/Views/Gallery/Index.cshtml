@using System.Globalization
@using ChuliTirth.Helpers
@model List<GalleryCategory>
@{
    ViewData["Title"] = "Gallery";
    var cultureInfo = CultureInfo.CurrentUICulture;
    string T(string key) => UiText.T(cultureInfo, key);
}
<section class="ct-section">
    <div class="container-ct">
        <div class="ct-section-title"><h2>@T("Gallery")</h2></div>
        @foreach (var cat in Model.Where(c => c.Images.Any()))
        {
            var catName = LocalizationHelper.Pick(cultureInfo, cat.Name, cat.NameGujarati, cat.NameHindi);
            <h4 class="mt-4">@catName</h4>
            <div class="ct-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px,1fr));">
                @foreach (var img in cat.Images)
                {
                    <a href="@img.ImageUrl" class="ct-gallery-img-link">
                        <img src="@img.ImageUrl" alt="@catName" loading="lazy" style="width:100%;height:170px;object-fit:cover;" />
                    </a>
                }
            </div>
        }
    </div>
</section>

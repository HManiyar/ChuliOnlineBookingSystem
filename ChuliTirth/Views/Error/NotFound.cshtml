@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}
<section class="ct-section text-center">
    <div class="container-ct">
        <h1 style="font-size:4rem;">404</h1>
        <h3>Page Not Found</h3>
        <p class="ct-muted">The page you are looking for does not exist or may have been moved.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-ct-primary">Return Home</a>
    </div>
</section>

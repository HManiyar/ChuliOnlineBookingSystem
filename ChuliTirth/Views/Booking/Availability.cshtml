@using System.Globalization
@using ChuliTirth.Helpers
@model AvailabilityResultsViewModel
@{
    ViewData["Title"] = "Check Availability";
    var cultureInfo = CultureInfo.CurrentUICulture;
    string T(string key) => UiText.T(cultureInfo, key);
}
<section class="ct-section">
    <div class="container-ct">
        <div class="ct-section-title" style="text-align:left;">
            <h2>@T("AvailableRooms")</h2>
            <p class="ct-muted">@Model.CheckIn.ToString("dd MMM yyyy") &rarr; @Model.CheckOut.ToString("dd MMM yyyy") &nbsp;·&nbsp; @Model.Guests guest(s) &nbsp;·&nbsp; @Model.Rooms room(s)</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ct-alert ct-alert-danger">
                <ul class="mb-0">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        else if (!Model.Results.Any())
        {
            <div class="ct-alert ct-alert-info">No rooms are available for the selected dates and guest count. Please try different dates.</div>
        }
        else
        {
            <div class="ct-grid">
                @foreach (var r in Model.Results)
                {
                    <div class="ct-card ct-room-card">
                        <img src="@(r.RoomType.Images.OrderBy(i=>i.DisplayOrder).FirstOrDefault()?.ImageUrl ?? "/images/rooms/placeholder-room.svg")" alt="@r.RoomType.Name" loading="lazy" />
                        <div class="body">
                            <h5 class="mb-0">@r.RoomType.Name</h5>
                            <div class="ct-muted" style="font-size:0.85rem;"><i class="bi bi-people"></i> Up to @r.RoomType.Capacity guests</div>
                            <div class="ct-badge ct-badge-confirmed" style="width:fit-content;">@r.AvailableRooms of @r.TotalRooms rooms available</div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="price">₹@r.RoomType.Price.ToString("N0") <small class="ct-muted">/ night</small></span>
                                <a class="btn-ct-primary" asp-controller="Booking" asp-action="GuestDetails"
                                   asp-route-roomTypeId="@r.RoomType.Id" asp-route-checkIn="@Model.CheckIn.ToString("yyyy-MM-dd")"
                                   asp-route-checkOut="@Model.CheckOut.ToString("yyyy-MM-dd")" asp-route-roomsNeeded="@Model.Rooms"
                                   asp-route-adults="@Model.Guests">@T("SelectRoom")</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

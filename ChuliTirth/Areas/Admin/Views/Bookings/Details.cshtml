@model Booking
@{
    ViewData["Title"] = $"Booking {Model.BookingNumber}";
    var payment = Model.Payments.OrderByDescending(p => p.Id).FirstOrDefault();
    var today = DateOnly.FromDateTime(IndianTimeHelper.NowIst());
    var checkInDue = today >= Model.CheckIn;
}

<div class="ct-card" style="padding:1.5rem;">
    <table class="table-ct w-100">
        <tbody>
            <tr><th>Booking Number</th><td>@Model.BookingNumber</td></tr>
            <tr><th>Guest</th><td>@Model.FirstName @Model.LastName &middot; @Model.Mobile &middot; @Model.Email</td></tr>
            <tr><th>Address</th><td>@Model.Address, @Model.City, @Model.State, @Model.Country</td></tr>
            <tr><th>Room(s)</th><td>@string.Join(", ", Model.BookingRooms.Select(r => $"{r.RoomType.Name} (#{r.Room.RoomNumber})"))</td></tr>
            <tr><th>Check-in / Check-out</th><td>@Model.CheckIn.ToString("dd MMM yyyy") &rarr; @Model.CheckOut.ToString("dd MMM yyyy") (@Model.Nights nights)</td></tr>
            <tr><th>Guests</th><td>@Model.Adults adults, @Model.Children children</td></tr>
            <tr><th>Special Requirements</th><td>@Model.SpecialRequirements</td></tr>
            <tr><th>Amount</th><td>Room: ₹@Model.RoomAmount.ToString("N2") + Additional: ₹@Model.AdditionalCharges.ToString("N2") = <strong>₹@Model.TotalAmount.ToString("N2")</strong></td></tr>
            <tr><th>Status</th><td><span class="ct-badge ct-badge-default">@Model.Status</span></td></tr>
            <tr><th>Payment Status</th><td>@Model.PaymentStatus</td></tr>
            @if (payment is not null)
            {
                <tr><th>Payment Method</th><td>@payment.Method @(payment.IsSimulated ? "(simulated)" : "")</td></tr>
                <tr><th>Gateway Order / Payment ID</th><td class="ct-muted" style="font-size:0.85rem;">@(payment.GatewayOrderId ?? "—") / @(payment.TransactionRef ?? "—")</td></tr>
            }
            <tr><th>Created</th><td>@Model.CreatedAtUtc.ToIst().ToString("dd MMM yyyy HH:mm") IST</td></tr>
        </tbody>
    </table>

    <div class="ct-divider"></div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status is BookingStatus.Pending or BookingStatus.PaymentPending)
        {
            <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="btn-ct-primary">Confirm</button></form>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post" onsubmit="return promptReason(this);">@Html.AntiForgeryToken()<input type="hidden" name="reason" /><button class="btn-ct-secondary">Reject</button></form>
        }
        @if (Model.Status == BookingStatus.Confirmed)
        {
            <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                @if (checkInDue)
                {
                    <button type="submit" class="btn-ct-primary">Check In</button>
                }
                else
                {
                    <button type="submit" class="btn-ct-primary" disabled title="Check-in opens on @Model.CheckIn.ToString("dd MMM yyyy")">Check In (opens @Model.CheckIn.ToString("dd MMM"))</button>
                }
            </form>
            <form asp-action="NoShow" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="btn-ct-secondary">Mark No-Show</button></form>
        }
        @if (Model.Status == BookingStatus.CheckedIn)
        {
            <form asp-action="CheckOut" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="btn-ct-primary">Check Out</button></form>
        }
        @if (Model.Status is not (BookingStatus.Cancelled or BookingStatus.Completed or BookingStatus.CheckedOut or BookingStatus.Rejected or BookingStatus.CheckedIn))
        {
            string? cancellationPreview = ViewBag.CancellationPreview;
            var cancelPromptMessage = "Reason for cancellation?" + (cancellationPreview is null ? "" : "\n\n" + cancellationPreview);
            <div class="d-flex flex-column gap-1">
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return promptReason(this, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cancelPromptMessage)));">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reason" />
                    <button class="btn-ct-secondary" style="color:var(--ct-danger);border-color:var(--ct-danger);">Cancel Booking</button>
                </form>
                @if (cancellationPreview is not null)
                {
                    <span class="ct-muted" style="font-size:0.75rem;">@cancellationPreview</span>
                }
            </div>
        }
        @if (payment is not null && payment.Status != PaymentStatus.Paid && payment.Method == "Razorpay")
        {
            <form asp-action="VerifyPayment" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Check Razorpay directly for a captured payment on this order?');">
                @Html.AntiForgeryToken()
                <button class="btn-ct-secondary">Verify Payment with Gateway</button>
            </form>
        }
        @if (Model.PaymentStatus == PaymentStatus.Paid)
        {
            <form asp-action="Refund" asp-route-id="@Model.Id" method="post" onsubmit="return promptReason(this, 'Refund reason (e.g. cancellation per policy):');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reason" />
                <button class="btn-ct-secondary" style="color:var(--ct-danger);border-color:var(--ct-danger);">Issue Refund</button>
            </form>
        }
        <button class="btn-ct-secondary" onclick="window.print()">Print</button>
    </div>
</div>

@section Scripts {
    <script>
        function promptReason(form, message) {
            var reason = prompt(message || "Please enter a reason:");
            if (!reason) return false;
            form.querySelector('input[name="reason"]').value = reason;
            return true;
        }
    </script>
}

@model JainQuote
<div class="ct-field mb-3"><label asp-for="TextEnglish"></label><textarea asp-for="TextEnglish" class="form-control"></textarea></div>
<div class="ct-field mb-3"><label asp-for="TextGujarati"></label><textarea asp-for="TextGujarati" class="form-control"></textarea></div>
<div class="ct-field mb-3"><label asp-for="TextHindi"></label><textarea asp-for="TextHindi" class="form-control"></textarea></div>
<div class="ct-field mb-3"><label asp-for="Attribution"></label><input asp-for="Attribution" class="form-control" /></div>
<div class="ct-field mb-3"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /> <label asp-for="IsActive" class="form-check-label"></label></div>
<button type="submit" class="btn-ct-primary">Save</button>
<a asp-action="Index" class="btn-ct-secondary">Cancel</a>

@model List<GalleryCategory>
@{ ViewData["Title"] = "Gallery"; }
@foreach (var cat in Model)
{
    <div class="ct-card mb-3" style="padding:1.25rem;">
        <h5>@cat.Name</h5>
        <div class="ct-grid" style="grid-template-columns: repeat(auto-fill, minmax(140px,1fr));">
            @foreach (var img in cat.Images)
            {
                <div>
                    <img src="@img.ImageUrl" style="width:100%;height:100px;object-fit:cover;border-radius:6px;" />
                    <form asp-action="DeleteImage" asp-route-id="@img.Id" method="post" onsubmit="return confirm('Remove image?');">
                        @Html.AntiForgeryToken()
                        <button class="btn-link" style="border:none;background:none;color:var(--ct-danger);font-size:0.8rem;">Remove</button>
                    </form>
                </div>
            }
        </div>
        <form asp-action="AddImage" method="post" class="d-flex gap-2 mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryId" value="@cat.Id" />
            <input type="text" name="imageUrl" class="form-control" placeholder="/images/gallery/your-image.jpg" required />
            <input type="text" name="caption" class="form-control" placeholder="Caption (optional)" />
            <button type="submit" class="btn-ct-secondary">Add</button>
        </form>
    </div>
}

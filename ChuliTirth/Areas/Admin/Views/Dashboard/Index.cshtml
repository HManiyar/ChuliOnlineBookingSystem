@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="ct-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px,1fr));">
    <div class="ct-stat-card"><div class="value">@Model.TodayCheckIns</div><div class="label">Today's Check-ins</div></div>
    <div class="ct-stat-card"><div class="value">@Model.TodayCheckOuts</div><div class="label">Today's Check-outs</div></div>
    <div class="ct-stat-card"><div class="value">@Model.CurrentGuests</div><div class="label">Current Guests</div></div>
    <div class="ct-stat-card"><div class="value">@Model.AvailableRooms</div><div class="label">Available Rooms</div></div>
    <div class="ct-stat-card"><div class="value">@Model.OccupiedRooms</div><div class="label">Occupied Rooms</div></div>
    <div class="ct-stat-card"><div class="value">@Model.PendingBookings</div><div class="label">Pending Bookings</div></div>
    <div class="ct-stat-card"><div class="value">@Model.ConfirmedBookings</div><div class="label">Confirmed Bookings</div></div>
    <div class="ct-stat-card"><div class="value">@Model.CancelledBookings</div><div class="label">Cancelled Bookings</div></div>
    <div class="ct-stat-card"><div class="value">₹@Model.RevenueThisMonth.ToString("N0")</div><div class="label">Revenue This Month</div></div>
</div>

<h5 class="mt-4">Recent Bookings</h5>
<div class="table-responsive-ct">
    <table class="table-ct w-100">
        <thead><tr><th>Booking #</th><th>Guest</th><th>Dates</th><th>Status</th><th>Payment</th><th>Amount</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model.RecentBookings)
            {
                <tr>
                    <td>@b.BookingNumber</td>
                    <td>@b.FirstName @b.LastName</td>
                    <td>@b.CheckIn.ToString("dd MMM") &rarr; @b.CheckOut.ToString("dd MMM")</td>
                    <td><span class="ct-badge ct-badge-default">@b.Status</span></td>
                    <td>@b.PaymentStatus</td>
                    <td>₹@b.TotalAmount.ToString("N0")</td>
                    <td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model List<Announcement>
@{ ViewData["Title"] = "Announcements"; }
<div class="ct-admin-topbar"><div></div><a asp-action="Create" class="btn-ct-primary">+ New Announcement</a></div>
<div class="table-responsive-ct">
    <table class="table-ct w-100">
        <thead><tr><th>Title</th><th>Priority</th><th>Active</th><th>Window</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Title</td>
                    <td>@a.Priority</td>
                    <td><span class="ct-badge @(a.IsActive ? "ct-badge-confirmed" : "ct-badge-cancelled")">@(a.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@a.StartAtUtc?.ToString("dd MMM") &ndash; @a.EndAtUtc?.ToString("dd MMM")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Delete?');" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn-link" style="border:none;background:none;color:var(--ct-danger);">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

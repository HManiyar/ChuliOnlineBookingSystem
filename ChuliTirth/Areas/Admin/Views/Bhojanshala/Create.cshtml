@model BhojanshalaTiming
@{ ViewData["Title"] = "New Bhojanshala Timing"; }
<form asp-action="Create" method="post" class="ct-card" style="padding:1.5rem;max-width:600px;">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-4 ct-field"><label asp-for="MealName"></label><input asp-for="MealName" class="form-control" /></div>
        <div class="col-md-4 ct-field"><label asp-for="MealNameGujarati"></label><input asp-for="MealNameGujarati" class="form-control" /></div>
        <div class="col-md-4 ct-field"><label asp-for="MealNameHindi"></label><input asp-for="MealNameHindi" class="form-control" /></div>
        <div class="col-md-6 ct-field"><label asp-for="StartTime"></label><input asp-for="StartTime" type="time" class="form-control" /></div>
        <div class="col-md-6 ct-field"><label asp-for="EndTime"></label><input asp-for="EndTime" type="time" class="form-control" /></div>
        <div class="col-md-8 ct-field"><label asp-for="Note"></label><input asp-for="Note" class="form-control" /></div>
        <div class="col-md-4 ct-field"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
    </div>
    <div class="ct-divider"></div>
    <button type="submit" class="btn-ct-primary">Save</button>
    <a asp-action="Index" class="btn-ct-secondary">Cancel</a>
</form>
